{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "isolatedModules": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./out-tsc/spec",
    "types": [
      "node",
      "jest"
    ]
  },
  "files": [

    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ],
  "angularCompilerOptions": {
    // "extendedDiagnostics": {
    //   "checks": {
    //     "nullishCoalescingNotNullable": "suppress",
    //     "optionalChainNotNullable": "suppress"
    //   }
    // },
    "strictTemplates": false
  }
}
